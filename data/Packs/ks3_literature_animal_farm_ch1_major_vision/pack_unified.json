      "data": {
        "title": "How Orwell Builds Major's Argument",
        "instruction": "Order the stages of Major's speech from problem to action.",
        "items": [
          "Major identifies the animals' miserable living conditions.",
          "He blames man for taking labour while giving little in return.",
          "He imagines a just future without human control.",
          "He warns the animals not to adopt human habits after rebellion.",
          "He unites the animals emotionally through the song 'Beasts of England'."
        ],
        "shuffle": true
