      ],
      "data": {
        "partOfSpeech": "keyword",
        "sourceWord": "Boolean logic",
        "targetWord": "A system of logic where every value is either True (1) or False (0), with no values in between — named after mathematician George Boole",
        "examples": {
          "en-GB": "Boolean logic underpins all digital computing because transistors can only be on (1) or off (0)."
        }
      }
    },
    {
      "id": "lg_v02",
      "type": "vocab",
      "level": "KS3 / Year 7-9",
      "topics": [
        "Logic Gates & Boolean Logic"
      ],
      "tags": [
        "KS3",
        "computing",
        "boolean"
      ],
      "data": {
        "partOfSpeech": "keyword",
        "sourceWord": "logic gate",
        "targetWord": "An electronic component that performs a Boolean operation on one or more binary inputs and produces a single binary output",
        "examples": {
          "en-GB": "An AND logic gate outputs 1 only when all of its inputs are 1."
        }
      }
    },
    {
      "id": "lg_v03",
      "type": "vocab",
      "level": "KS3 / Year 7-9",
      "topics": [
        "Logic Gates & Boolean Logic"
      ],
      "tags": [
        "KS3",
        "computing",
        "boolean"
      ],
      "data": {
        "partOfSpeech": "keyword",
        "sourceWord": "truth table",
        "targetWord": "A table that shows every possible combination of inputs and the resulting output for a logic gate or circuit — a gate with n inputs has 2^n rows",
        "examples": {
          "en-GB": "A truth table for a two-input AND gate has four rows, covering all combinations of 0 and 1."
        }
      }
    },
    {
      "id": "lg_v04",
      "type": "vocab",
      "level": "KS3 / Year 7-9",
      "topics": [
        "Logic Gates & Boolean Logic"
      ],
      "tags": [
        "KS3",
        "computing",
        "boolean"
      ],
      "data": {
        "partOfSpeech": "keyword",
        "sourceWord": "NOT gate",
        "targetWord": "A logic gate with a single input that inverts it — input 0 gives output 1, and input 1 gives output 0",
        "examples": {
          "en-GB": "A NOT gate is also called an inverter because it reverses the value of its input."
        }
      }
    },
    {
      "id": "lg_v05",
      "type": "vocab",
      "level": "KS3 / Year 7-9",
      "topics": [
        "Logic Gates & Boolean Logic"
      ],
      "tags": [
        "KS3",
        "computing",
        "boolean"
      ],
      "data": {
        "partOfSpeech": "keyword",
        "sourceWord": "AND gate",
        "targetWord": "A logic gate that outputs 1 only when ALL of its inputs are 1; any input of 0 gives an output of 0",
        "examples": {
          "en-GB": "The AND gate models a security door that opens only when both a keycard AND a correct PIN are provided."
        }
      }
    },
    {
      "id": "lg_v06",
      "type": "vocab",
      "level": "KS3 / Year 7-9",
      "topics": [
        "Logic Gates & Boolean Logic"
      ],
      "tags": [
        "KS3",
        "computing",
        "boolean"
      ],
      "data": {
        "partOfSpeech": "keyword",
        "sourceWord": "OR gate",
        "targetWord": "A logic gate that outputs 1 when at least one of its inputs is 1; it only outputs 0 when all inputs are 0",
        "examples": {
          "en-GB": "A burglar alarm that triggers if either the door sensor OR the window sensor detects movement uses OR gate logic."
        }
      }
    },
    {
      "id": "lg_v07",
      "type": "vocab",
      "level": "KS3 / Year 7-9",
      "topics": [
        "Logic Gates & Boolean Logic"
      ],
      "tags": [
        "KS3",
        "computing",
        "boolean"
      ],
      "data": {
        "partOfSpeech": "keyword",
        "sourceWord": "NAND gate",
        "targetWord": "A NOT-AND gate that outputs 0 only when all inputs are 1; in all other cases it outputs 1 — the opposite of an AND gate",
        "examples": {
          "en-GB": "The NAND gate is a universal gate because any other gate type can be built from combinations of NAND gates."
        }
      }
    },
    {
      "id": "lg_v08",
      "type": "vocab",
      "level": "KS3 / Year 7-9",
      "topics": [
        "Logic Gates & Boolean Logic"
      ],
      "tags": [
        "KS3",
        "computing",
        "boolean"
      ],
      "data": {
        "partOfSpeech": "keyword",
        "sourceWord": "NOR gate",
        "targetWord": "A NOT-OR gate that outputs 1 only when all inputs are 0; in all other cases it outputs 0 — the opposite of an OR gate",
        "examples": {
          "en-GB": "A NOR gate outputs 1 only when there is no activity on any input — it is the only gate that outputs 1 when everything is quiet."
        }
      }
    },
    {
      "id": "lg_v09",
      "type": "vocab",
      "level": "KS3 / Year 7-9",
      "topics": [
        "Logic Gates & Boolean Logic"
      ],
      "tags": [
        "KS3",
        "computing",
        "boolean"
      ],
      "data": {
        "partOfSpeech": "keyword",
        "sourceWord": "XOR gate",
        "targetWord": "An Exclusive OR gate that outputs 1 only when its inputs are different (one is 0 and the other is 1); it outputs 0 when both inputs are the same",
        "examples": {
          "en-GB": "XOR is used in binary addition because 1 XOR 1 equals 0, mirroring how the sum bit behaves when adding two 1s."
        }
      }
    },
    {
      "id": "lg_v10",
      "type": "vocab",
      "level": "KS3 / Year 7-9",
      "topics": [
        "Logic Gates & Boolean Logic"
      ],
      "tags": [
        "KS3",
        "computing",
        "boolean"
      ],
      "data": {
        "partOfSpeech": "keyword",
        "sourceWord": "input",
        "targetWord": "A binary value (0 or 1) fed into a logic gate or circuit to be processed",
        "examples": {
          "en-GB": "An AND gate has two inputs; both must be 1 for the output to be 1."
        }
      }
    },
    {
      "id": "lg_v11",
      "type": "vocab",
      "level": "KS3 / Year 7-9",
      "topics": [
        "Logic Gates & Boolean Logic"
      ],
      "tags": [
        "KS3",
        "computing",
        "boolean"
      ],
      "data": {
        "partOfSpeech": "keyword",
        "sourceWord": "output",
        "targetWord": "The binary value (0 or 1) produced by a logic gate after it has processed its inputs",
        "examples": {
          "en-GB": "The output of a NOT gate is always the opposite of its input."
        }
      }
    },
    {
      "id": "lg_v12",
      "type": "vocab",
      "level": "KS3 / Year 7-9",
      "topics": [
        "Logic Gates & Boolean Logic"
      ],
      "tags": [
        "KS3",
        "computing",
        "boolean"
      ],
      "data": {
        "partOfSpeech": "keyword",
        "sourceWord": "binary",
        "targetWord": "A number system that uses only two digits, 0 and 1, which directly represents the two states of electronic components in computers",
        "examples": {
          "en-GB": "Logic gates work in binary because each transistor inside a computer can only be in one of two states: on (1) or off (0)."
        }
      }
    },
    {
      "id": "lg_v13",
      "type": "vocab",
      "level": "KS3 / Year 7-9",
      "topics": [
        "Logic Gates & Boolean Logic"
      ],
      "tags": [
        "KS3",
        "computing",
        "boolean"
      ],
      "data": {
        "partOfSpeech": "keyword",
        "sourceWord": "True",
        "targetWord": "One of the two Boolean values, represented as 1, indicating that a condition or signal is active or correct",
        "examples": {
          "en-GB": "In programming, a condition evaluates to True (1) when it is met, triggering the corresponding branch of code."
        }
      }
    },
    {
      "id": "lg_v14",
      "type": "vocab",
      "level": "KS3 / Year 7-9",
      "topics": [
        "Logic Gates & Boolean Logic"
      ],
      "tags": [
        "KS3",
        "computing",
        "boolean"
      ],
      "data": {
        "partOfSpeech": "keyword",
        "sourceWord": "False",
        "targetWord": "One of the two Boolean values, represented as 0, indicating that a condition or signal is inactive or incorrect",
        "examples": {
          "en-GB": "When a gate input is False (0), it has no active signal passing through."
        }
      }
    },
    {
      "id": "lg_v15",
      "type": "vocab",
      "level": "KS3 / Year 7-9",
      "topics": [
        "Logic Gates & Boolean Logic"
      ],
      "tags": [
        "KS3",
        "computing",
        "boolean"
      ],
      "data": {
        "partOfSpeech": "keyword",
        "sourceWord": "complement",
        "targetWord": "The opposite Boolean value of a given value — the complement of 1 is 0, and the complement of 0 is 1; produced by a NOT gate",
        "examples": {
          "en-GB": "A NOT gate produces the complement of its input, so if the input is 1, the complement output is 0."
        }
      }
    },
    {
      "id": "lg_v16",
      "type": "vocab",
      "level": "KS3 / Year 7-9",
      "topics": [
        "Logic Gates & Boolean Logic"
      ],
      "tags": [
        "KS3",
        "computing",
        "boolean"
      ],
      "data": {
        "partOfSpeech": "keyword",
        "sourceWord": "conjunction",
        "targetWord": "A Boolean operation that is true only when all conditions are true — corresponds to the AND gate and the AND operator in programming",
        "examples": {
          "en-GB": "The statement 'it is raining AND it is cold' is a conjunction — it is only true when both individual conditions are true."
        }
      }
    },
    {
      "id": "lg_v17",
      "type": "vocab",
      "level": "KS3 / Year 7-9",
      "topics": [
        "Logic Gates & Boolean Logic"
      ],
      "tags": [
        "KS3",
        "computing",
        "boolean"
      ],
      "data": {
        "partOfSpeech": "keyword",
        "sourceWord": "disjunction",
        "targetWord": "A Boolean operation that is true when at least one condition is true — corresponds to the OR gate and the OR operator in programming",
        "examples": {
          "en-GB": "The statement 'it is raining OR it is cloudy' is a disjunction — it is true if either or both conditions are true."
        }
      }
    },
    {
      "id": "lg_v18",
      "type": "vocab",
      "level": "KS3 / Year 7-9",
      "topics": [
        "Logic Gates & Boolean Logic"
      ],
      "tags": [
        "KS3",
        "computing",
        "boolean"
      ],
      "data": {
        "partOfSpeech": "keyword",
        "sourceWord": "exclusive",
        "targetWord": "In Boolean logic, referring to operations where the true condition must apply to exactly one input but not both — as in the XOR (Exclusive OR) gate",
        "examples": {
          "en-GB": "The XOR gate is exclusive because it outputs 1 only when exactly one input is 1, not when both are 1."
        }
      }
    },
    {
      "id": "lg_v19",
      "type": "vocab",
      "level": "KS3 / Year 7-9",
      "topics": [
        "Logic Gates & Boolean Logic"
      ],
      "tags": [
        "KS3",
        "computing",
        "boolean"
      ],
      "data": {
        "partOfSpeech": "keyword",
        "sourceWord": "digital circuit",
        "targetWord": "A circuit built from logic gates that processes binary signals (0s and 1s) to perform a specific logical or arithmetic function",
        "examples": {
          "en-GB": "The ALU inside a CPU is a digital circuit made up of thousands of logic gates that perform arithmetic and logic operations."
        }
      }
    },
    {
      "id": "lg_v20",
      "type": "vocab",
      "level": "KS3 / Year 7-9",
      "topics": [
        "Logic Gates & Boolean Logic"
      ],
      "tags": [
        "KS3",
        "computing",
        "boolean"
      ],
      "data": {
        "partOfSpeech": "keyword",
        "sourceWord": "Boolean expression",
        "targetWord": "An algebraic expression using Boolean operators (AND, OR, NOT) and variables that evaluates to either True (1) or False (0)",
        "examples": {
          "en-GB": "The Boolean expression 'A AND (NOT B)' evaluates to 1 only when A is 1 and B is 0."
        }
      }
    },
    {
      "id": "lg_v21",
      "type": "vocab",
      "level": "KS3 / Year 7-9",
      "topics": [
        "Logic Gates & Boolean Logic"
      ],
      "tags": [
        "KS3",
        "computing",
        "boolean"
      ],
      "data": {
        "partOfSpeech": "keyword",
        "sourceWord": "operand",
        "targetWord": "A value that an operator acts upon — in Boolean logic, operands are the binary inputs (0 or 1) that gates process",
        "examples": {
          "en-GB": "In the expression A AND B, the variables A and B are the operands that the AND operation acts upon."
        }
      }
    },
    {
      "id": "lg_v22",
      "type": "vocab",
      "level": "KS3 / Year 7-9",
      "topics": [
        "Logic Gates & Boolean Logic"
