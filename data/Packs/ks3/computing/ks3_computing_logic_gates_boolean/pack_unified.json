      ],
      "data": {
        "partOfSpeech": "keyword",
        "sourceWord": "universal gate",
        "targetWord": "A logic gate from which any other gate type can be constructed using combinations of that gate alone — both NAND and NOR are universal gates",
        "examples": {
          "en-GB": "Because NAND is a universal gate, the entire instruction set of a CPU could theoretically be built using only NAND gates."
        }
      }
    },
    {
      "id": "lg_v25",
