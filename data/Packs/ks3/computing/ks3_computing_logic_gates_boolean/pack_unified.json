      "data": {
        "partOfSpeech": "keyword",
        "sourceWord": "logic circuit",
        "targetWord": "Multiple connected logic gates where the output of one gate feeds into the input of another to perform a more complex logical function",
        "examples": {
          "en-GB": "Connecting an AND gate followed by a NOT gate creates a logic circuit equivalent to a single NAND gate."
        }
      }
    },
