      "data": {
        "partOfSpeech": "keyword",
        "sourceWord": "transistor",
        "targetWord": "A tiny electronic switch that can be either on (1) or off (0); billions of transistors inside a CPU physically implement logic gates",
        "examples": {
          "en-GB": "Modern processors contain billions of transistors, each acting as a microscopic switch that forms part of a logic gate."
        }
      }
    },
    {
      "id": "lg_v24",
      "type": "vocab",
      "level": "KS3 / Year 7-9",
      "topics": [
