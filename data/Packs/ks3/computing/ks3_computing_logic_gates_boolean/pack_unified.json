      "tags": [
        "KS3",
        "computing",
        "boolean"
      ],
      "data": {
        "partOfSpeech": "keyword",
        "sourceWord": "bit",
        "targetWord": "A single binary digit — either 0 or 1 — which is the smallest unit of data processed by a logic gate",
        "examples": {
          "en-GB": "Each input and output of a logic gate carries exactly one bit of information."
        }
      }
    },
    {
      "id": "lg_v23",
      "type": "vocab",
      "level": "KS3 / Year 7-9",
      "topics": [
